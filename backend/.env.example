# 数据库
DATABASE_URL=postgresql+asyncpg://fire:fire@localhost:5432/fire_alarm_sys

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
# ⚠️ 部署前必须替换 SECRET_KEY！
# 当前值为仓库占位符，公网/演示/生产环境若继续使用，攻击者可伪造 JWT Access Token、
# WS Ticket，从而绕过登录、冒充任意角色（含主管）、读取或篡改全部数据。
# 生成方式（Linux/macOS/WSL）：openssl rand -hex 32
# 该值仅保存在部署目标机的 .env 中，禁止提交到 git。
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 设备上报预共享密钥（X-Device-Key）
# ⚠️ 若允许设备/网关直连接口 /api/v1/monitor/report，必须设置此项且与 SECRET_KEY 不同。
# 未配置时服务端会拒绝所有匿名设备上报；留空仅在本地开发/纯手动测试时可用。
DEVICE_REPORT_KEY=

# 安全
MAX_LOGIN_FAILS=5
LOCK_DURATION_MINUTES=30

# 环境
ENV=development
