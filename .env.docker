# 数据库 (Docker 环境下使用容器名)
DATABASE_URL=postgresql+asyncpg://fire:fire@postgres:5432/fire_alarm_sys

# Redis (Docker 环境下使用容器名)
REDIS_URL=redis://redis:6379/0

# JWT
# ⚠️ 部署前必须替换 SECRET_KEY！
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 设备上报通道前置（testing-guidelines 第四节硬要求）
# 端点判据是 `ALLOW_DEVICE_REPORT or DEBUG`，此前只靠 DEBUG=True 兜底；
# 而 DEVICE_REPORT_KEY 为空串时 `verify_device_key` 的 `not expected` 恒真
# → 无论带什么 header 都 401，真火警根本造不出来。
# ⚠️ 部署前必须：改用强随机 KEY，并把 ALLOW_DEVICE_REPORT 改回 false ——
#    该端点绕过 JWT 与 require_permission，只靠这一个预共享密钥把关。
ALLOW_DEVICE_REPORT=true
DEVICE_REPORT_KEY=dev-report-key-change-in-production
# 关闭每 60 秒的离线扫描：它会把设备刷成 offline 并生成 fault 告警，
# 设备上报类验证进行到一半就被它搅乱（同 testing-guidelines 第四节）。
OFFLINE_SCAN_ENABLED=false

# 安全
MAX_LOGIN_FAILS=5
LOCK_DURATION_MINUTES=30

# 环境
ENV=development

#  Workers
WORKERS=1
