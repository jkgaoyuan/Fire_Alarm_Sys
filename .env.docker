# 数据库 (Docker 环境下使用容器名)
DATABASE_URL=postgresql+asyncpg://fire:fire@postgres:5432/fire_alarm_sys

# Redis (Docker 环境下使用容器名)
REDIS_URL=redis://redis:6379/0

# JWT
# ⚠️ 部署前必须替换 SECRET_KEY！
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 设备上报预共享密钥（X-Device-Key）
DEVICE_REPORT_KEY=

# 安全
MAX_LOGIN_FAILS=5
LOCK_DURATION_MINUTES=30

# 环境
ENV=development

#  Workers
WORKERS=1
